{
  "name": "marriott-trip-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate:schema": "node --import tsx scripts/validate-foundation.ts && npm run validate:catalog",
    "catalog:health": "node --import tsx scripts/catalog-health.ts",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ci": "vitest run",
    "test:browser": "playwright test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm run validate:schema && npm run test:ci && npm run build",
    "validate:catalog": "node --import tsx scripts/validate-catalog.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
